{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bootstrap-sha": "a1dc3679ed3e41d53a0816b818a5d385dd3dcd88",
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "mcpwp",
      "component": "",
      "include-component-in-tag": false,
      "version-file": "mcpwp/VERSION",
      "changelog-path": "mcpwp/CHANGELOG.md",
      "include-v-in-tag": true,
      "exclude-paths": ["mcp-server", "mcpwp-agency-proxy"],
      "pull-request-title-pattern": "chore: release MCPWP ${version}",
      "extra-files": [
        { "type": "generic", "path": "mcpwp/mcpwp.php" },
        { "type": "generic", "path": "mcpwp/readme.txt" },
        { "type": "json", "path": "version.json", "jsonpath": "$.version" }
      ]
    },
    "mcp-server": {
      "release-type": "node",
      "component": "mcp-server",
      "include-component-in-tag": true,
      "tag-separator": "-"
    },
    "mcpwp-agency-proxy": {
      "release-type": "node",
      "component": "mcpwp-agency-proxy",
      "include-component-in-tag": true,
      "tag-separator": "-"
    }
  }
}
