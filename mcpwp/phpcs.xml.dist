<?xml version="1.0"?>
<ruleset name="Mumega MCP WordPress.org">
	<description>WordPress.org coding standards for the extracted, shipped plugin artifact.</description>

	<!-- Supply the extracted mumega-mcp directory as the PHPCS command-line path. -->
	<arg name="extensions" value="php" />
	<config name="minimum_wp_version" value="6.1" />
	<config name="testVersion" value="7.4-" />

	<rule ref="WordPress" />
	<rule ref="PHPCompatibilityWP" />

	<!-- The plugin intentionally defines and checks this custom capability. -->
	<rule ref="WordPress.WP.Capabilities">
		<properties>
			<property name="custom_capabilities" type="array">
				<element value="mcpwp_manage_settings" />
			</property>
		</properties>
	</rule>

	<!--
		These two legacy class/file pairs are loaded by stable plugin paths. Renaming
		them would require a compatibility migration unrelated to coding standards.
	-->
	<rule ref="PEAR.NamingConventions.ValidClassName.Invalid">
		<exclude-pattern>*/includes/class-mcpwp-i18n.php</exclude-pattern>
	</rule>
	<rule ref="WordPress.Files.FileName.InvalidClassFileName">
		<exclude-pattern>*/includes/admin/class-mcpwp-activity-log.php</exclude-pattern>
	</rule>
</ruleset>
