# WP.org directory assets. Every build applies these. build-freemius.sh then
# copies back assets/mcpwp-mark-ochre.* alone (admin header badge). The
# Freemius SDK icon lives under freemius/assets/img/ (not affected here).
/assets/*.png
/assets/*.svg
/includes/class-mcpwp-updater.php

# Never ship local Cloudflare/wrangler state (account id + name).
.wrangler
.wrangler/*
