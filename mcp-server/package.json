{
  "name": "@mcpwp.net/mcpwp",
  "version": "3.0.3",
  "mcpName": "io.github.mumega848/mcpwp",
  "publishConfig": {
    "access": "public"
  },
  "description": "MCPWP proxy for WordPress - dynamic MCP tools for posts, pages, Elementor, WooCommerce, LearnPress, SEO, forms & more. Works with Claude Desktop, Cursor, Windsurf and any MCP client.",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "mcpwp": "dist/index.js"
  },
  "scripts": {
    "build": "bun build src/index.ts --target=node --outfile=dist/index.js --format=esm",
    "build:tsc": "tsc",
    "test": "node --test test/*.test.mjs",
    "start": "node dist/index.js",
    "dev": "bun run src/index.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mumega-com/mcp-for-wp.git"
  },
  "homepage": "https://mcpwp.net",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist/index.js",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "wordpress",
    "ai",
    "claude",
    "elementor",
    "woocommerce",
    "learnpress",
    "seo",
    "chatgpt",
    "cursor",
    "windsurf",
    "site-pilot",
    "model-context-protocol"
  ],
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@types/node": "^20.11.0",
    "dotenv": "^16.4.5",
    "typescript": "^5.3.3"
  },
  "author": "Mumega",
  "license": "MIT"
}
